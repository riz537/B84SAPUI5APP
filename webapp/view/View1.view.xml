<mvc:View controllerName="com.demo.b84sapui5app.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:l="sap.ui.layout"
   xmlns:f="sap.ui.layout.form">
   <Page title="I am View1">
      <content>
         <f:SimpleForm title="Employee Details" editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="4" columnsL="3" >
            <f:content>
               <Label text="Employee ID" required="true"></Label>
               <Input id="oIpEmpId" liveChange="onSubmit"></Input>
               <Label text="Name" required="true"></Label>
               <Input id="oIpName" liveChange="onSubmit"></Input>
               <Label text="Designation"></Label>
               <Input ></Input>
               <Label text="Email ID"></Label>
               <Input ></Input>
               <Label text="Phone No"></Label>
               <Input ></Input>
               <Label text="Salary"></Label>
               <Input ></Input>
            </f:content>
         </f:SimpleForm>

      </content>
      <footer>
         <Bar >
            <contentRight>
              <Button text="Submit" type="Emphasized" press="onSubmit"></Button>
            </contentRight>

         </Bar>
      </footer>
   </Page>
</mvc:View>

